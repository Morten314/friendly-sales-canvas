# Frontend build-time environment contract (spec 42).
#
# LOVABLE: keep `.env` committed — Lovable preview reads VITE_* from the repo
# after GitHub sync. Do not add `.env` to .gitignore.
#
# LOCAL UVICORN: copy `.env.local.example` → `.env.local` (gitignored) to point
# the dev proxy at http://127.0.0.1:8000 without changing the shared `.env`.
#
# VERCEL / production deploy: set the same keys in the host's env UI; use the
# full backend URL for BOTH vars (no /api proxy on static hosts):
#   VITE_API_BASE_URL=https://<render-host>
#   VITE_BACKEND_BASE_URL=https://<render-host>

VITE_API_BASE_URL=/api
VITE_BACKEND_BASE_URL=https://brewra-gtm-intelligence-1.onrender.com
