# Frontend build-time environment contract (spec 42).
#
# LOVABLE (committed .env): both vars MUST be the full Render host — the Lovable
# cloud preview does not apply Vite's /api dev proxy.
#
# LOCAL with Vite proxy: copy `.env.local.example` → `.env.local` (gitignored):
#   VITE_API_BASE_URL=/api
#   VITE_BACKEND_BASE_URL=http://127.0.0.1:8000  (or the Render URL)

# Lovable static preview: set VITE_DISABLE_PWA=true (committed .env) — workbox breaks iframe.

VITE_API_BASE_URL=https://brewra-gtm-intelligence-1.onrender.com
VITE_BACKEND_BASE_URL=https://brewra-gtm-intelligence-1.onrender.com
VITE_DISABLE_PWA=true
