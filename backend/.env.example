# Backend environment contract (spec 42). Copy to backend/.env for local dev
# and fill with your own values. backend/.env is gitignored — never commit it.
# Every variable below without a default is REQUIRED: the app fails hard at
# startup if it is missing or empty (no silent fallback to production).

# --- Neo4j ---
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<neo4j-password>

# --- MongoDB: full SRV connection string (paste from Atlas, URL-encode the password) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=<app>

# --- LLM / external APIs ---
TOGETHER_API_KEY=<together-key>
TAVILY_API_KEY=<tavily-key>
RAPIDAPI_KEY=<rapidapi-key>
# Required for *_claude endpoints (not checked at startup, but calls fail without it)
ANTHROPIC_API_KEY=<anthropic-key>

# --- Pinecone ---
PINECONE_API_KEY=<pinecone-key>
PINECONE_INDEX=brewra-documents

# --- AWS S3 ---
S3_BUCKET=<bucket-name>
AWS_REGION=<aws-region>
AWS_ACCESS_KEY=<aws-access-key-id>
AWS_SECRET_KEY=<aws-secret-access-key>

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5175

# --- Optional tuning constants (spec 42 D4): identical across environments,
# overridable, with in-code defaults. Uncomment only to override. ---
# CLAUDE_SONNET_MODEL=claude-sonnet-4-6
# CLAUDE_SIGNAL_WINDOW_SECONDS=300
# CLAUDE_SIGNAL_TOKEN_LIMIT_5M=1000000
# CLAUDE_SIGNAL_MAX_OUTPUT_TOKENS=4000
