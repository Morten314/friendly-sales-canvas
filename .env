# Committed for Lovable preview + GitHub sync (spec 42).
# Lovable's sandbox does NOT run Vite's /api proxy — use the full Render URL
# for BOTH vars so API calls reach Brewra from the cloud preview.
# For local uvicorn + Vite proxy, copy .env.local.example → .env.local (gitignored).

VITE_API_BASE_URL=https://brewra-gtm-intelligence-1.onrender.com
VITE_BACKEND_BASE_URL=https://brewra-gtm-intelligence-1.onrender.com
# Lovable static preview: service worker breaks iframe (workbox logo.png conflict).
VITE_DISABLE_PWA=true
