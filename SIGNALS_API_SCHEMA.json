{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signals API Schema",
  "description": "Schema for Signals API endpoints with keywords and context for generating rich descriptions",
  "type": "object",
  "definitions": {
    "SignalCard": {
      "type": "object",
      "required": ["id", "agent", "timestamp", "headline", "snippet", "sourceUrl", "sourceLabel"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the signal"
        },
        "agent": {
          "type": "string",
          "enum": ["scout", "profiler"],
          "description": "Agent type that generated the signal"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp or relative time (e.g., '1h ago', 'Today')"
        },
        "headline": {
          "type": "string",
          "description": "Brief headline summarizing the signal",
          "minLength": 10,
          "maxLength": 150
        },
        "snippet": {
          "type": "string",
          "description": "Detailed description/context of the signal. Should be comprehensive (150-500 characters) with actionable insights, implications, and relevant context",
          "minLength": 150,
          "maxLength": 500
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL to the original source of the signal"
        },
        "sourceLabel": {
          "type": "string",
          "description": "Human-readable label for the source (e.g., 'Press release link', 'LinkedIn post link', 'TechCrunch article')"
        }
      }
    },
    "SignalContext": {
      "type": "object",
      "description": "Additional context and keywords to help generate rich descriptions",
      "properties": {
        "industry": {
          "type": "string",
          "description": "Industry context (e.g., 'SaaS', 'FinTech', 'Healthcare')"
        },
        "companySize": {
          "type": "string",
          "description": "Company size segment (e.g., '50-200 employees', 'Enterprise')"
        },
        "companyUrl": {
          "type": "string",
          "format": "uri",
          "description": "Company website URL"
        },
        "strategicGoals": {
          "type": "string",
          "description": "Strategic goals or objectives"
        },
        "primaryGTMModel": {
          "type": "string",
          "description": "Primary Go-To-Market model (e.g., 'Direct sales', 'Channel partners')"
        },
        "revenueStage": {
          "type": "string",
          "description": "Revenue stage (e.g., 'Growth', 'Early stage', 'Mature')"
        },
        "keyBuyerPersona": {
          "type": "string",
          "description": "Primary buyer persona (e.g., 'CTO', 'VP of Sales', 'CMO')"
        },
        "targetMarkets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Target market regions or segments"
        },
        "icpSegments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ideal Customer Profile segments"
        },
        "competitiveLandscape": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Key competitors or competitive context"
        },
        "marketTrends": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Relevant market trends"
        },
        "painPoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Common pain points of target customers"
        },
        "useCases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Relevant use cases or scenarios"
        }
      }
    }
  },
  "properties": {
    "generateSignalsBatchRequest": {
      "type": "object",
      "description": "Request schema for POST /api/generate-signals-batch",
      "required": ["user_id", "component_name", "data"],
      "properties": {
        "user_id": {
          "type": "string",
          "description": "User identifier for multi-tenancy"
        },
        "component_name": {
          "type": "string",
          "description": "Component name identifier"
        },
        "data": {
          "$ref": "#/definitions/SignalContext",
          "description": "Context data for signal generation"
        },
        "refresh": {
          "type": "boolean",
          "description": "Whether to refresh/generate new signals",
          "default": true
        }
      }
    },
    "generateSignalsBatchResponse": {
      "type": "object",
      "description": "Response schema for POST /api/generate-signals-batch",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success", "error"],
          "description": "Response status"
        },
        "message": {
          "type": "string",
          "description": "Response message"
        },
        "data": {
          "type": "object",
          "properties": {
            "signals_generated": {
              "type": "integer",
              "description": "Number of signals generated"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "Generation timestamp"
            }
          }
        }
      }
    },
    "fetchSignalsRequest": {
      "type": "object",
      "description": "Query parameters for GET /api/fetch-signals",
      "properties": {
        "user_id": {
          "type": "string",
          "description": "User identifier for multi-tenancy"
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of signals to return",
          "default": 10,
          "minimum": 1,
          "maximum": 100
        },
        "agent": {
          "type": "string",
          "enum": ["scout", "profiler", "all"],
          "description": "Filter by agent type",
          "default": "all"
        },
        "offset": {
          "type": "integer",
          "description": "Offset for pagination",
          "default": 0,
          "minimum": 0
        }
      },
      "required": ["user_id"]
    },
    "fetchSignalsResponse": {
      "type": "object",
      "description": "Response schema for GET /api/fetch-signals",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success", "error"],
          "description": "Response status"
        },
        "data": {
          "type": "object",
          "properties": {
            "signals": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/SignalCard"
              },
              "description": "Array of signal cards"
            },
            "total": {
              "type": "integer",
              "description": "Total number of signals available"
            },
            "limit": {
              "type": "integer",
              "description": "Limit applied to the query"
            },
            "offset": {
              "type": "integer",
              "description": "Offset applied to the query"
            }
          }
        }
      }
    }
  },
  "keywordsForRichDescriptions": {
    "description": "Keywords and context fields that should be used when generating rich snippet descriptions",
    "snippetGenerationGuidelines": {
      "minLength": 150,
      "maxLength": 500,
      "shouldInclude": [
        "Actionable implications for the user's business",
        "Relevance to ICP segments or target markets",
        "Impact on competitive positioning",
        "Specific context about why this signal matters",
        "Potential opportunities or risks",
        "Connection to strategic goals or buyer personas",
        "Quantitative data when available (percentages, numbers, timeframes)",
        "Next steps or recommended actions"
      ],
      "tone": "Professional, insightful, and actionable",
      "structure": "Start with the immediate impact, then provide context, and end with implications"
    },
    "contextFieldsToLeverage": [
      "industry",
      "companySize",
      "strategicGoals",
      "primaryGTMModel",
      "revenueStage",
      "keyBuyerPersona",
      "targetMarkets",
      "icpSegments",
      "competitiveLandscape",
      "marketTrends",
      "painPoints",
      "useCases"
    ],
    "agentSpecificGuidelines": {
      "scout": {
        "focus": "Market intelligence, competitive moves, industry trends, funding rounds, market shifts",
        "descriptionStyle": "Emphasize market-wide implications, competitive dynamics, and strategic opportunities",
        "keywords": [
          "market impact",
          "competitive positioning",
          "industry trends",
          "market opportunity",
          "strategic implications",
          "competitive landscape",
          "market dynamics",
          "growth trajectory"
        ]
      },
      "profiler": {
        "focus": "ICP-specific insights, buyer persona activities, prospect signals, engagement patterns",
        "descriptionStyle": "Emphasize relevance to specific ICP segments, buyer personas, and actionable outreach opportunities",
        "keywords": [
          "ICP relevance",
          "buyer persona",
          "prospect engagement",
          "outreach opportunity",
          "target segment",
          "decision maker",
          "buying signals",
          "engagement patterns"
        ]
      }
    },
    "signalTypeKeywords": {
      "competitor": [
        "competitive move",
        "market positioning",
        "pricing strategy",
        "feature launch",
        "market share",
        "competitive differentiation"
      ],
      "funding": [
        "market confidence",
        "growth trajectory",
        "competitive landscape",
        "market opportunity",
        "investment trends",
        "market validation"
      ],
      "icp_segment": [
        "target segment",
        "ICP profile",
        "buyer persona",
        "market penetration",
        "segment opportunity",
        "customer profile"
      ],
      "social_signal": [
        "buyer engagement",
        "pain point",
        "buying signal",
        "outreach opportunity",
        "decision maker",
        "engagement pattern"
      ],
      "industry_trend": [
        "market trend",
        "industry shift",
        "market evolution",
        "strategic opportunity",
        "market dynamics",
        "growth driver"
      ]
    }
  },
  "exampleRichSnippet": {
    "description": "Example of a rich snippet description (150-500 characters)",
    "example": "This competitive pricing move by Company X directly impacts your SMB segment in the mid-market SaaS space. With 40% of your current pipeline falling into this category, this development could accelerate decision timelines or create pricing pressure. The launch targets companies with 50-200 employees—your core ICP—and includes features that overlap with your value proposition. Consider monitoring early adoption signals and preparing competitive differentiation messaging that emphasizes your unique ROI model and enterprise-grade capabilities."
  }
}


