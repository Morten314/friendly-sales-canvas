# Local-only overrides — copy to .env.local (gitignored, wins over .env).
# Use when running `npm run dev` locally with the Vite /api proxy.
#
# Local dev: point at the working backend (matches Vercel production):
VITE_API_BASE_URL=/api
VITE_BACKEND_BASE_URL=https://brewra-gtm-intelligence.onrender.com

# Lovable uses committed .env (brewra-gtm-intelligence-1) — leave that unchanged.
#
# For a local uvicorn backend instead of Render, use:
# VITE_BACKEND_BASE_URL=http://127.0.0.1:8000
