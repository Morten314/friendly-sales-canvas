{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://brewra-gtm-intelligence.onrender.com/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install"
}
