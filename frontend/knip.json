{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "vite.config.ts",
    "playwright.config.ts",
    "e2e/**/*.spec.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    "scripts/**/*.{ts,sh}"
  ],
  "ignore": [
    "dev-dist/**",
    "node_modules/**",
    "dist/**"
  ]
}
