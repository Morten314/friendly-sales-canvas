{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/**/*.{ts,tsx}!",
    "!src/test/**",
    "!src/**/__tests__/**",
    "!src/**/*.{test,spec}.{ts,tsx}",
    "e2e/**/*.spec.ts",
    "scripts/*.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"],
  "ignore": ["src/components/ui/**", "src/shared/components/**"],
  "ignoreDependencies": ["tailwindcss-animate", "tsx"]
}
